# API Configuration
VITE_API_URL=http://localhost:4000/api

# App Configuration
VITE_APP_NAME=Dai Trading ERP
VITE_APP_VERSION=1.0.0

# Environment
VITE_ENV=development

# Features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Company Information
VITE_COMPANY_NAME_EN=Dai Trading
VITE_COMPANY_NAME_AR=داي تريدينج
VITE_COMPANY_PHONE=+974-3045-3010
VITE_COMPANY_EMAIL=info@daitrading.qa

# Pagination
VITE_DEFAULT_PAGE_SIZE=50
VITE_MAX_PAGE_SIZE=100

# File Upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Date Format
VITE_DATE_FORMAT=yyyy-MM-dd
VITE_DATETIME_FORMAT=yyyy-MM-dd HH:mm:ss

# Default Language
VITE_DEFAULT_LANGUAGE=en

# Theme
VITE_DEFAULT_THEME=light
