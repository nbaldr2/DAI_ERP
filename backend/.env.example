# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=daifresh
DB_USER=root
DB_PASS=yourpassword
DB_DIALECT=mysql

# JWT Configuration
JWT_SECRET=supersecretkey_change_this_in_production
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Expiry Alert Configuration
EXPIRY_ALERT_DAYS=7
CRON_SCHEDULE=0 2 * * *

# Invoice Configuration
COMPANY_NAME_EN=Dai Trading
COMPANY_NAME_AR=داي تريدينج
COMPANY_ADDRESS_EN=Doha, Qatar
COMPANY_ADDRESS_AR=الدوحة، قطر
COMPANY_TAX_ID=123456789
COMPANY_PHONE=+974-XXXXXXXX
COMPANY_EMAIL=info@daitrading.qa

# AWS S3 Configuration (Optional)
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Backup Configuration
BACKUP_DIR=./backups
